# Execution is local until the owner authorizes external resource writes and spending.
MASUMI_STATE_DIR=
MASUMI_EXTERNAL_WRITES_AUTHORIZED=false
MASUMI_PAYMENTS_AUTHORIZED=false
PAID_TASKS_ENABLED=false
COWORKER_ID=
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
AGENT_AUTHOR=
MPS_URL=http://127.0.0.1:38127
MASUMI_REGISTRATION_FILE=
MPS_RUNTIME_TOKEN_FILE=
MPS_BUYER_RUNTIME_TOKEN_FILE=
# Keep MPS_RUNTIME_TOKEN, ADMIN_KEY and ENCRYPTION_KEY in separate private files.
# The Coworker runtime credential stays in the supported CLI vault.
BLOCKFROST_API_KEY_PREPROD=
# Optional explanation model. The deterministic inspector owns acceptance.
INSPECTOR_MODEL_ENABLED=false
INSPECTOR_MODEL_URL=
INSPECTOR_MODEL_NAME=
INSPECTOR_MODEL_API_KEY=
INSPECTOR_MODEL_TIMEOUT_MS=15000
INSPECTOR_MODEL_MAX_OUTPUT_TOKENS=512
# Set an absolute application-owned worker bridge module after root integration.
INSPECTION_BRIDGE_MODULE=
