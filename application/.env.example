FIELDPROOF_MODE=simulation
FIELDPROOF_PORT=4021
# Runtime files default to the user state directory, outside source.
# FIELDPROOF_STATE_DIR=
# Physical commissioning needs device pins, address, and secret. Payments stay disabled.
# FIELDPROOF_MODE=physical
# FIELDPROOF_RECEIPT_PINS=/private/proof-ready/device-pins.json
# FIELDPROOF_BLE_ADDRESS=
# FIELDPROOF_DEVICE_SECRET=
# FIELDPROOF_PYTHON=
# Optional independently enrolled Seeker public-key export. No private key belongs here.
# PROOFREADY_PHONE_PUBLIC_KEY_FILE=/private/proof-ready/phone-public-key.json
# Optical execution requires board-specific GPIO configuration and targeted authorization.
# PROOFREADY_OPTICAL_AUTHORIZED=false
# Existing paid inspector/contract state is read only. No payment or transaction signs here.
# PROOFREADY_EXTERNAL_CONFIG=/private/proof-ready/external.json
# Direct-payment lab requires separate Preprod configuration and explicit authorization.
# FIELDPROOF_MODE=preprod
# SELLER_ADDRESS=
# FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
# BLOCKFROST_PROJECT_ID=
# MNEMONIC=
# FIELDPROOF_SPEND_AUTHORIZED=false
# Masumi support can be checked without credentials: npm run check:masumi
# The direct-payment lab stays separate from the isolated integrations/masumi worker.
